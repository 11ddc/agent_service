# ════════════════════════════════════════════════════════════════════════
#  环境变量模板 —— 复制成 .env 再填自己的 key
#
#      cp .env.example .env          # Linux / macOS
#      copy .env.example .env        # Windows
#
#  ⚠️ .env 已被 .gitignore 排除，**任何真实 key 都不要提交**。
#     本文件（.env.example）是模板，里面的值全是占位符，可以安全入库。
#
#  整体只需要 **2 个厂商的 key** 就能跑通全部主链路：
#     ① DeepSeek  —— 主模型（改写 / 意图仲裁 / 兜底 Agent）
#     ② 阿里云百炼 DashScope —— 答案生成 + 问题拆分（+ 可选：云端向量、视觉 OCR）
#     智谱是可选的第三条链路（工具调用），不配则工具分支不可用，其余功能正常。
# ════════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────────
# 【必需 ①】DeepSeek —— 主模型
#   申请：https://platform.deepseek.com/api_keys
#   用处（三处，且三个模块在 import 时就会构造客户端）：
#     · agent/langchina.py    兜底 Agent 主模型（deepseek-chat）
#     · intent/classifier.py  三级意图漏斗的 LLM 仲裁层
#     · query_rewrite/rewriter.py  带上下文的 query 改写
#   缺失时：改写降级为原样返回、意图第 3 层不可用 → 仍能跑，但回答质量明显下降
# ────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 【必需 ②】阿里云百炼 DashScope —— 生成 + 拆分
#   申请：https://bailian.console.aliyun.com/  →  API-KEY 管理
#
#   ⚠️ 下面三个变量其实是**同一个 DashScope 账号下的 key**，可以直接填同一个值。
#      之所以拆成三个名字，是因为它们各自身处不同模块、用的接口路径/模型不同，
#      历史上是分别写死的（同一把钥匙三个位置）。想省事就三处填一样。
# ────────────────────────────────────────────────────────────────────────

# 答案生成（rag/generatellm.py，模型 qwen3-32b，走 compatible-mode）
GENERATE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多问题拆分（intent/problemdecomposition.py，模型 qwen3.5-flash）
# 走的是百炼「应用」协议路径 /api/v2/apps/protocols/compatible-mode/v1
QIAN_WEN_QUERYSTION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】云端向量 + 视觉 OCR（rag/local_embedding.py、rag/vision_ocr.py）
#   · 只有把 EMBEDDING_PROVIDER 设成 dashscope（云端 text-embedding-v2）才需要
#   · 只有解析扫描件/图内文字（VISION_OCR_MODE=auto 且本地 OCR 识别为空）才需要
#   默认配置是本地向量（EMBEDDING_PROVIDER=local）+ 本地 OCR，所以**不填也能跑**；
#   填了才能处理纯图片扫描页。
QIANWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 【可选】智谱开放平台 —— 工具调用模型
#   申请：https://open.bigmodel.cn/  →  API Keys
#   用处：tools_agent/tool_llm.py，模型 glm-4.5-air，
#         负责"LLM ⇄ 工具"循环里的 function calling（走 /api/paas/v4/）
#   缺失时：只影响 tool_call 分支，知识库问答（kb_question）主链路不受影响，
#           意图路由会把问题导向 RAG 而不是工具。
# ────────────────────────────────────────────────────────────────────────
ZHI_PU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 基础设施
# ────────────────────────────────────────────────────────────────────────

# 【必需】MySQL —— 存放父块全文（small-to-big 里的"big"）
#   建库：CREATE DATABASE rag DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   建表：python -m db.init_schema
#   注意 charset=utf8mb4 不能省：父块含 OCR 文本，3 字节的 "utf8" 存不下生僻字。
#   连不上时不会崩，检索会自动降级为纯子块。
MYSQL_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/rag?charset=utf8mb4

# 【可选】Redis —— 会话历史 + 转人工计数窗口，默认即本机 6379，一般不用改
# 连不上时会话历史会失败，但问答主链路仍可用。
REDIS_URL=redis://localhost:6379


# ────────────────────────────────────────────────────────────────────────
# 可选调优（不写就用代码里的默认值，下面括号里是默认值）
# ────────────────────────────────────────────────────────────────────────

# ── 检索层 ──
# 换 embedding 模型 = 换向量空间（维度也变）→ 必须同时换 CHROMA_COLLECTION 并全量重建
# EMBEDDING_PROVIDER=local            # local | dashscope
# EMBEDDING_MODEL_PATH=               # 留空=优先用 embbding_models/bge-small-zh-v1.5，
#                                     #       该目录不存在则自动退回 HF 仓库 BAAI/bge-small-zh-v1.5 下载
# EMBEDDING_DEVICE=cuda               # 没有 N 卡会自动退回 cpu，不用改
# EMBEDDING_BATCH_SIZE=32
# RERANK_MODEL_PATH=                  # 留空=优先用 Reank_models/bge-reranker-v2-m3，
#                                     #       不存在则退回 HF 仓库 BAAI/bge-reranker-v2-m3 下载
# RERANK_DEVICE=cuda                  # 同上，不可用自动退 cpu。没配好会导致精排静默失效
# CHROMA_COLLECTION=knowledge_base_bge512
# CHROMA_SPACE=cosine                 # bge 是归一化余弦模型，别改成 l2
# HF_ENDPOINT=https://hf-mirror.com   # 国内下模型走镜像（config.py 已默认设置）

# ── OCR ──
# VISION_OCR_MODE=auto                # auto(本地 OCR 为空才调视觉模型) | always | off
# VISION_MODEL=qwen3-vl-flash
# TESSERACT_CMD=                      # 留空=Windows 默认装法自动探测，否则走 PATH。
#                                     # 装在别处（或 Linux/macOS）时在这里指全路径

# ── 意图 / 改写超时 ──
# INTENT_LLM_TIMEOUT=12
# INTENT_LLM_MAX_RETRIES=1
# REWRITE_TIMEOUT=8
# REWRITE_MAX_RETRIES=1
# REWRITE_SHORT_QUERY_LEN=8           # 短于这个长度才触发 query 改写

# ── MCP 外部工具 ──
# 留空 = 用内置默认（只起 mcp_server.py）。serverName 决定工具命名空间
# mcp__<serverName>__<tool>；"python" 会被替换成当前解释器。
MCP_SERVERS=[{"serverName":"mcp_server","transport":"stdio","command":"python","args":["mcp_server.py"]},{"serverName":"order","transport":"stdio","command":"python","args":["mcp_order_server.py"]}]


# ════════════════════════════════════════════════════════════════════════
# 关于原来 .env 里那两个**已经删掉**的变量，说明一下免得有人再填回来：
#
#   BASE_URL                      —— 全仓库没有任何 os.getenv("BASE_URL")。
#                                    各模块的 base_url 都是写死的常量，
#                                    这个变量从来没被读过，纯死配置。
#
#   QWEN_RERANK_API_KEY           —— 只出现在 rag/rag.py 的**注释**里
#                                    （那段 DashScope gte-rerank-v2 的云端精排代码
#                                    已被注释掉，现在用的是本地 LocalReranker）。
#                                    填了不生效，不用申请。
# ════════════════════════════════════════════════════════════════════════
