# ════════════════════════════════════════════════════════════════════════
#  环境变量模板 —— 复制成 .env 再填自己的 key
#
#      cp .env.example .env          # Linux / macOS
#      copy .env.example .env        # Windows
#
#  ⚠️ .env 已被 .gitignore 排除，**任何真实 key 都不要提交**。
#     本文件（.env.example）是模板，里面的值全是占位符，可以安全入库。
#
#  整体只需要 **2 个厂商的 key** 就能跑通全部主链路：
#     ① DeepSeek  —— 主模型（改写 / 意图仲裁 / 兜底 Agent）
#     ② 阿里云百炼 DashScope —— 答案生成 + 问题拆分（+ 可选：云端向量、视觉 OCR）
#     智谱是可选的第三条链路（工具调用），不配则工具分支不可用，其余功能正常。
# ════════════════════════════════════════════════════════════════════════


# ────────────────────────────────────────────────────────────────────────
# 【必需 ①】DeepSeek —— 主模型
#   申请：https://platform.deepseek.com/api_keys
#   用处（三处，且三个模块在 import 时就会构造客户端）：
#     · agent/langchina.py    兜底 Agent 主模型（deepseek-chat）
#     · intent/classifier.py  三级意图漏斗的 LLM 仲裁层
#     · query_rewrite/rewriter.py  带上下文的 query 改写
#   缺失时：改写降级为原样返回、意图第 3 层不可用 → 仍能跑，但回答质量明显下降
# ────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 【必需 ②】阿里云百炼 DashScope —— 生成 + 拆分
#   申请：https://bailian.console.aliyun.com/  →  API-KEY 管理
#
#   ⚠️ 下面三个变量其实是**同一个 DashScope 账号下的 key**，可以直接填同一个值。
#      之所以拆成三个名字，是因为它们各自身处不同模块、用的接口路径/模型不同，
#      历史上是分别写死的（同一把钥匙三个位置）。想省事就三处填一样。
# ────────────────────────────────────────────────────────────────────────

# 答案生成（rag/generatellm.py，模型 qwen3-32b，走 compatible-mode）
GENERATE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多问题拆分（intent/problemdecomposition.py，模型 qwen3.5-flash）
# 走的是百炼「应用」协议路径 /api/v2/apps/protocols/compatible-mode/v1
QIAN_WEN_QUERYSTION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】云端向量 + 视觉 OCR（rag/local_embedding.py、rag/vision_ocr.py）
#   · 只有把 EMBEDDING_PROVIDER 设成 dashscope（云端 text-embedding-v2）才需要
#   · 只有解析扫描件/图内文字（VISION_OCR_MODE=auto 且本地 OCR 识别为空）才需要
#   默认配置是本地向量（EMBEDDING_PROVIDER=local）+ 本地 OCR，所以**不填也能跑**；
#   填了才能处理纯图片扫描页。
QIANWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 【可选】智谱开放平台 —— 工具调用模型
#   申请：https://open.bigmodel.cn/  →  API Keys
#   用处：tools_agent/tool_llm.py，模型 glm-4.5-air，
#         负责"LLM ⇄ 工具"循环里的 function calling（走 /api/paas/v4/）
#   缺失时：只影响 tool_call 分支，知识库问答（kb_question）主链路不受影响，
#           意图路由会把问题导向 RAG 而不是工具。
# ────────────────────────────────────────────────────────────────────────
ZHI_PU_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx


# ────────────────────────────────────────────────────────────────────────
# 【必需】认证与授权
#
# 为什么必需：这是"谁在用、他能看什么"的唯一凭据。
#   · 缺 AUTH_JWT_SECRET 时服务**启动即失败**（刻意的：如果允许缺省，代码里就得有
#     一个内置默认密钥 —— 那等于任何人都能伪造任意身份的令牌，而服务看起来一切正常）；
#   · 开启认证之后 **MySQL 从"建议"变成"必需"**：账号体系存在库里，
#     连不上时受保护接口返回 503（失败关闭，绝不降级成放行）。
#
# 生成密钥（至少 32 字节：HS256 的密钥长度直接决定签名强度）：
#     python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# 首个管理员：自助注册只能拿到最低角色 user，所以要用引导脚本建第一个 admin：
#     BOOTSTRAP_ADMIN_PASSWORD=你的密码 python -m auth.bootstrap --username admin
#   （账号已存在时默认不动它；要提权加 --promote）
# ────────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=请替换成随机生成的长密钥

# 本地演示可以关掉认证，但**生产绝不可以**（启动会打 WARNING，/health 也会暴露状态）
# AUTH_ENABLED=1
# 企业内部一般关闭自助注册，改由管理员建号（POST /api/auth/users，需要 admin）
# AUTH_ALLOW_REGISTRATION=1
# 令牌有效期：访问令牌短、刷新令牌长；刷新会**轮换**（旧的立即失效）
# AUTH_ACCESS_TTL_SECONDS=900          # 15 分钟
# AUTH_REFRESH_TTL_SECONDS=2592000     # 30 天
# 密码策略与在线爆破防护（按账号锁定，不用 IP —— IP 会被 NAT/代理池绕过）
# AUTH_MIN_PASSWORD_LEN=8
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCK_SECONDS=300
# bcrypt 代价（越高越慢越安全；跑测试可以降到 4）
# AUTH_BCRYPT_ROUNDS=12
# 自助注册固定使用这两个值，**不接受客户端指定**（否则就是提权与越租户后门）
# AUTH_DEFAULT_ROLE=user
# AUTH_DEFAULT_TENANT=default
# 只有在**可信反向代理之后**才打开：X-Forwarded-For 是客户端可伪造的，
# 打开它等于让调用方自己决定"被记成哪个 IP"
# TRUST_PROXY_HEADERS=0


# ────────────────────────────────────────────────────────────────────────
# 【必需】基础设施
# ────────────────────────────────────────────────────────────────────────

# 【必需】MySQL —— 存放父块全文（small-to-big 里的"big"）
#   建库：CREATE DATABASE rag DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   建表：python -m db.init_schema
#   注意 charset=utf8mb4 不能省：父块含 OCR 文本，3 字节的 "utf8" 存不下生僻字。
#   连不上时不会崩，检索会自动降级为纯子块。
MYSQL_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/rag?charset=utf8mb4

# 【可选】Redis —— 会话历史 + 转人工计数窗口，默认即本机 6379，一般不用改
# 连不上时会话历史会失败，但问答主链路仍可用。
REDIS_URL=redis://localhost:6379


# ────────────────────────────────────────────────────────────────────────
# 可选调优（不写就用代码里的默认值，下面括号里是默认值）
# ────────────────────────────────────────────────────────────────────────

# ── 检索层 ──
# 换 embedding 模型 = 换向量空间（维度也变）→ 必须同时换 CHROMA_COLLECTION 并全量重建
# EMBEDDING_PROVIDER=local            # local | dashscope
# EMBEDDING_MODEL_PATH=               # 留空=优先用 embbding_models/bge-small-zh-v1.5，
#                                     #       该目录不存在则自动退回 HF 仓库 BAAI/bge-small-zh-v1.5 下载
# EMBEDDING_DEVICE=cuda               # 没有 N 卡会自动退回 cpu，不用改
# EMBEDDING_BATCH_SIZE=32
# RERANK_MODEL_PATH=                  # 留空=优先用 Reank_models/bge-reranker-v2-m3，
#                                     #       不存在则退回 HF 仓库 BAAI/bge-reranker-v2-m3 下载
# RERANK_DEVICE=cuda                  # 同上，不可用自动退 cpu。没配好会导致精排静默失效
# CHROMA_COLLECTION=knowledge_base_bge512
# CHROMA_SPACE=cosine                 # bge 是归一化余弦模型，别改成 l2
# HF_ENDPOINT=https://hf-mirror.com   # 国内下模型走镜像（config.py 已默认设置）

# ── OCR ──
# VISION_OCR_MODE=auto                # auto(本地 OCR 为空才调视觉模型) | always | off
# VISION_MODEL=qwen3-vl-flash
# TESSERACT_CMD=                      # 留空=Windows 默认装法自动探测，否则走 PATH。
#                                     # 装在别处（或 Linux/macOS）时在这里指全路径

# ── 意图 / 改写超时 ──
# INTENT_LLM_TIMEOUT=12
# INTENT_LLM_MAX_RETRIES=1
# REWRITE_TIMEOUT=8
# REWRITE_MAX_RETRIES=1
# REWRITE_SHORT_QUERY_LEN=8           # 短于这个长度才触发 query 改写

# ── 其余出网调用的超时（秒）──
# 每一个都有默认值，通常不用改。为什么全都要设：这些客户端都跑在**同步图节点**
# 里（由 api/chat.py 丢进线程池），没有超时的话一次网络卡顿就会把工作线程长期占住。
# AGENT_LLM_TIMEOUT=60                # 兜底 Agent（DeepSeek）
# AGENT_LLM_MAX_RETRIES=1
# GENERATE_TIMEOUT=60                 # RAG 答案生成（qwen3-32b）
# GENERATE_MAX_RETRIES=1
# SPLIT_TIMEOUT=15                    # 多问题拆分（qwen3.5-flash）
# SPLIT_MAX_RETRIES=1
# ZHIPU_TIMEOUT=30                    # 工具调用模型（glm-4.5-air）
# ZHIPU_MAX_RETRIES=1
# MCP_TIMEOUT=30                      # 单次 MCP 调用（起子进程 + 握手 + 执行）
# GRAPH_RECURSION_LIMIT=25            # 编排图步数上限。工具循环是个环，必须有限；
#                                     # 不设的话 langgraph 默认按 10007 走

# ── 请求体上限 ──
# 在 body_limit.py 里：单文件 50MB / 整个请求体 51MB（留 multipart 帧开销）。
# 它在 multipart 解析**之前**生效 —— 否则超限请求会先被完整缓冲到内存/临时盘。

# ── 知识库 ACL 与审核发布 ──
# 企业知识库既有"全员可见的手册"，也有"只有售后能看的内部判责标准"。
# ACL 默认**开启**：每个子块带 tenant_id / owner_id / visibility / status，
# dense（Chroma where）与 sparse（BM25）**两条通道都会过滤**。
#
# ⚠️ 开启后，缺少 ACL 元数据的存量块会被判为"不可见"（失败方向是拒绝）。
#    存量库跑一次回填即可（幂等，支持 --dry-run）：
#        python -m rag.acl_backfill --dry-run
#        python -m rag.acl_backfill
#    ACL_ENABLED=0 会退回"不过滤"，只应出现在本地演示。
# ACL_ENABLED=1
# 新上传文档的默认可见范围：tenant（本租户）/ private（仅上传者）/ public（所有租户）
# ACL_DEFAULT_VISIBILITY=tenant
# 上传后是否需要审核才能被检索到：
#   true （企业默认）上传 → draft（检索不到）→ 审核发布 → published
#   false（本地省事）上传即 published
# ACL_REQUIRE_APPROVAL=1

# ── 可观测性 ──
# 日志级别（每条日志都带 request_id，格式：时间 级别 [模块] rid=xxx 消息）
# LOG_LEVEL=INFO
# /metrics 是否要求 admin。默认要求 —— 指标会暴露业务量级（咨询量、转人工率）与成本。
# 集群内用 Prometheus 抓取时：要么配 bearer token，要么设成 0 并且只在内部网暴露。
# METRICS_REQUIRE_AUTH=1
# 应用版本（/health 与 OpenAPI 文档都用它）
# APP_VERSION=0.2.0
# BM25 索引的磁盘缓存目录（冷启动免去全量拉取 + 分词；可随时删除重建）
# BM25_CACHE_DIR=./bm25_cache
#
# 探针（不需要鉴权，k8s 的探针不会带令牌）：
#   GET /health   存活：进程活着就 200，并列出 AUTH/ACL/限流 开关状态（便于告警）
#   GET /ready    就绪：MySQL 不可用且认证开启 → 503；Redis 挂了仍就绪（只是降级）；
#                 向量库未初始化也算就绪（**探针绝不去加载模型**）
#   GET /metrics  Prometheus 文本格式

# ── 内容审核与日志脱敏 ──
# 两件事分开：**违规内容拦截**（黑名单）与 **PII 脱敏**（日志/审计）。
# 客服场景里用户主动给手机号/订单号是正常的，把 PII 当违规拦掉会把最需要
# 人工帮助的用户挡在门外。
# MODERATION_ENABLED=1
# rule（离线规则，默认，不出网）| http（外部内容安全服务，需出网，尚未接入实现）
# MODERATION_PROVIDER=rule
# 额外禁用词，逗号分隔（留空则用 moderation.py 里的少量内置样例）
# MODERATION_TERMS=词A,词B
# 审核组件出错时：1=放行（默认，审核故障不该让客服停摆），0=拦截
# MODERATION_FAIL_OPEN=1
# 单次审核扫描的最大字符数（限制成本）
# MODERATION_MAX_CHARS=20000
# 日志里的手机号/身份证/银行卡/邮箱是否打码
# MODERATION_MASK_LOGS=1

# ── 入口限流（按账号的令牌桶）──
# 按账号而不是按 IP：IP 会被 NAT/代理池绕过，却会误伤整个出口。
# Redis 可用时用 Lua 原子执行；Redis 不可用时降级为**进程内**限流
# （仍然限流，只是每副本一份 —— 多副本部署请把限流指向 Redis）。
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_PER_MINUTE=30      # 每分钟补充的令牌数（持续速率）
# RATE_LIMIT_BURST=10           # 桶容量 = 允许的瞬时突发

# ── 会话记忆（LangGraph checkpointer）──
# memory（默认）= 进程内：**重启即丢、多副本各存一份**。症状是"客服怎么又忘了"，
# 极难归因，所以启动时会打 WARNING 提醒。
# 企业部署请改成 sqlite（单副本）或 postgres（多副本），并安装对应依赖：
#     pip install langgraph-checkpoint-sqlite    或    langgraph-checkpoint-postgres
# 配了但依赖没装会**直接启动失败**（不会悄悄退回 memory）。
# AGENT_CHECKPOINT_BACKEND=memory
# AGENT_CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite
# AGENT_CHECKPOINT_POSTGRES_URL=postgresql://user:pass@host:5432/db

# ── MCP 外部工具 ──
# 留空 = 用内置默认（只起 mcp_server.py）。serverName 决定工具命名空间
# mcp__<serverName>__<tool>；"python" 会被替换成当前解释器。
MCP_SERVERS=[{"serverName":"mcp_server","transport":"stdio","command":"python","args":["mcp_server.py"]},{"serverName":"order","transport":"stdio","command":"python","args":["mcp_order_server.py"]}]

# ── 订单工具的业务身份边界 ──
# 身份**不由工具参数决定**：MCP 服务读的是子进程环境变量
#   · MCP_CALLER_ID        —— 已认证的账号（principal），由 mcp_client 注入
#   · MCP_RESOLVED_CUSTOMER —— 后端解析好的客户号（users.customer_id → 令牌 → 注入）
# 模型无法影响子进程环境，所以伪造不了"我是谁 / 我对应哪个客户"。
# 下面两个是"还没有账号体系时"的过渡开关，**接好认证后应保持单租户关闭**：
# ORDER_DEMO_SINGLE_TENANT=1        # 1=所有调用方都映射到同一个演示客户（单租户）
# ORDER_PRINCIPAL_MAP={"u_abc":"C2"} # principal → 客户号 的显式映射
# ⚠️ 注意：这些变量由 mcp_client 显式转发给子进程（SDK 的环境白名单不含业务配置，
#    不转发的话服务端会用默认值继续跑且不报错）


# ════════════════════════════════════════════════════════════════════════
# 关于原来 .env 里那两个**已经删掉**的变量，说明一下免得有人再填回来：
#
#   BASE_URL                      —— 全仓库没有任何 os.getenv("BASE_URL")。
#                                    各模块的 base_url 都是写死的常量，
#                                    这个变量从来没被读过，纯死配置。
#
#   QWEN_RERANK_API_KEY           —— 只出现在 rag/rag.py 的**注释**里
#                                    （那段 DashScope gte-rerank-v2 的云端精排代码
#                                    已被注释掉，现在用的是本地 LocalReranker）。
#                                    填了不生效，不用申请。
# ════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════
# 构建期镜像源（只在 `docker compose build` 时生效，不进容器运行时逻辑）
#
# 这三个变量对应 Dockerfile 里的 ARG，**不需要改 Dockerfile 就能换源**——
# 换源不必再手改仓库文件，也就不会和 `git pull` 打架。
# 留空 = 官方源（deb.debian.org / pypi.org / download.pytorch.org），行为不变。
#
# 阿里云 ECS（走内网，最快、也不计公网流量）：
#   APT_MIRROR=mirrors.cloud.aliyuncs.com
#   PIP_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pypi/simple/
#   TORCH_INDEX_URL=http://mirrors.cloud.aliyuncs.com/pytorch-wheels/cpu
#
# 国内公网（非 ECS 环境）：
#   APT_MIRROR=mirrors.aliyun.com
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   TORCH_INDEX_URL=https://mirrors.aliyun.com/pytorch-wheels/cpu
#
# 为什么 torch 要单独给一个源：Linux 上 PyPI 的 torch 默认是 **CUDA 版**，
# 会连带拖 ~2.5GB 的 nvidia-* 依赖（镜像 ~4GB → ~11GB、构建慢一个数量级）。
# Dockerfile 里已经先单独装 CPU 版 torch，这里只决定"从哪个镜像站下"。
# 注意：一旦改了这三个值（或从没设置改成设置），apt/pip 那两层缓存会失效、
# 需要重新构建——这是预期行为。
# ════════════════════════════════════════════════════════════════════════
